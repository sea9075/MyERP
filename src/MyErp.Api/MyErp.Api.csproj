<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      固定的 UserSecretsId：本機開發用的連線字串／JWT 簽章金鑰都靠 `dotnet user-secrets`
      存在這個 Id 對應的檔案裡，不會進到 Git。MyErp.Infra/MyErpDbContextFactory.cs 裡
      「設計期」用的 AddUserSecrets(...) 也是寫死同一組 Id，兩邊才讀得到同一份 secrets。
    -->
    <UserSecretsId>a3f1e9d2-6c4b-4a7e-9f0d-1b2c3d4e5f6a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- 讓 dotnet ef migrations add（以 src/MyErp.Api 當 startup project）可以正常運作。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyErp.Domain\MyErp.Domain.csproj" />
    <ProjectReference Include="..\MyErp.Application\MyErp.Application.csproj" />
    <ProjectReference Include="..\MyErp.Infra\MyErp.Infra.csproj" />
  </ItemGroup>

</Project>
