# 相依套件（本機 npm install 產生，不進版控）
node_modules

# build 產物
dist
dist-ssr

# tsc -b（專案參照 / project references）的增量編譯快取，2026-09-15 拆成
# tsconfig.json（solution 用，只有 references）+ tsconfig.app.json 之後才會產生
*.tsbuildinfo

# 環境設定檔：這兩個目前雖然只有 API 網址、沒有機密資訊，但慣例上還是不進版控，
# 避免以後有人不小心把真正的機密（例如正式環境的 API 網址背後接的服務金鑰）也一起 commit 上去。
# 內容範本見 README.md「開發環境設定」章節，或直接跟 Claude 要一份。
.env
.env.*
!.env.example

# 編輯器/系統
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
